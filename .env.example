# ==============================================================================
# KoridorTJ Environment Configuration Template (.env.example)
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit the real .env file containing credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL & WAREHOUSE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Logical Databases
POSTGRES_DB_WAREHOUSE=warehouse
POSTGRES_DB_AIRFLOW=airflow_meta

# Dedicated Ingestion & Pipeline User (used by Airflow, dbt, tap_consumer)
POSTGRES_INGESTION_USER=ingestion_user
POSTGRES_INGESTION_PASSWORD=ingestion_dev_password

# Read-Only Warehouse User (used by Apache Superset)
POSTGRES_SUPERSET_USER=superset_ro
POSTGRES_SUPERSET_PASSWORD=superset_ro_dev_password

# ------------------------------------------------------------------------------
# 2. APACHE AIRFLOW CONFIGURATION
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
# Generate Fernet key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here_32_bytes_base64_encoded==
# Generate Secret key using: openssl rand -hex 30
AIRFLOW__CORE__SECRET_KEY=your_airflow_secret_key_here
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_DATABASE_URL=postgresql+psycopg2://ingestion_user:ingestion_dev_password@postgres:5432/airflow_meta

# ------------------------------------------------------------------------------
# 3. APACHE KAFKA (KRaft mode) & STREAMING PIPELINE
# ------------------------------------------------------------------------------
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_TAPS=taps.raw
KAFKA_TOPIC_DEADLETTER=taps.deadletter
# Replay multiplier: 144.0 means 1 day (1440 mins) replayed in 10 minutes
REPLAY_SPEED_MULTIPLIER=144.0

# ------------------------------------------------------------------------------
# 4. APACHE SUPERSET & GUEST TOKEN SERVICE
# ------------------------------------------------------------------------------
SUPERSET_SECRET_KEY=your_superset_secret_key_here_change_in_production
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin_dev_password
SUPERSET_URL=http://superset:8088
SUPERSET_DASHBOARD_ID=your_superset_dashboard_uuid_here

# Guest Token Signing Secret (used by Guest Token Service & Superset EMBEDDED_SUPERSET)
GUEST_TOKEN_SECRET=your_guest_token_signing_secret_here
GUEST_TOKEN_SERVICE_PORT=8080

# ------------------------------------------------------------------------------
# 5. DEPLOYMENT & HOSTING (Coolify / VPS / Domains)
# ------------------------------------------------------------------------------
# Coolify API Token for CI/CD automated deployment trigger
COOLIFY_API_TOKEN=your_coolify_api_token_here

# Public Subdomains (configured in Coolify with automatic Traefik SSL)
DOMAIN_EMBED=embed.yourdomain.com
DOMAIN_DBTDOCS=dbtdocs.yourdomain.com
