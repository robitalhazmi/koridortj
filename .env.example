# ==============================================================================
# KoridorTJ Environment Configuration Template (.env.example)
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit the real .env file containing credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL & WAREHOUSE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Logical Databases
POSTGRES_DB_WAREHOUSE=warehouse
POSTGRES_DB_AIRFLOW=airflow_meta
POSTGRES_DB_SUPERSET=superset_meta

# Dedicated Ingestion & Pipeline User (used by Airflow, dbt, tap_consumer)
POSTGRES_INGESTION_USER=ingestion_user
POSTGRES_INGESTION_PASSWORD=ingestion_dev_password

# Read-Only Warehouse User (used by Apache Superset and Token Service)
POSTGRES_READONLY_USER=superset_ro
POSTGRES_READONLY_PASSWORD=superset_ro_dev_password

# ------------------------------------------------------------------------------
# 2. APACHE AIRFLOW CONFIGURATION
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
# Generate Fernet key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=46BKJoKc-CtANjlbbbDWgrMvaJ34GWA7oAq6_qGCmTZ=
# Generate Secret key using: openssl rand -hex 30
AIRFLOW__CORE__SECRET_KEY=koridortj_secret_key_1234567890abcdef
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false

# ------------------------------------------------------------------------------
# 3. APACHE KAFKA (KRaft mode) & STREAMING PIPELINE
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW=taps.raw
KAFKA_TOPIC_DLQ=taps.deadletter
# Replay multiplier (e.g., 60.0 means 1 hour replayed in 1 minute)
REPLAY_SPEED_MULTIPLIER=60.0

# ------------------------------------------------------------------------------
# 4. APACHE SUPERSET & GUEST TOKEN SERVICE
# ------------------------------------------------------------------------------
SUPERSET_SECRET_KEY=koridortj_superset_secret_key_9876543210abcdef
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@koridortj.id
SUPERSET_DOMAIN=http://localhost:8088
SUPERSET_DASHBOARD_ID=45d44fda-4e9c-4a88-894d-819f66fbfd33

# Guest Token Signing Secret (used by Guest Token Service & Superset EMBEDDED_SUPERSET)
SUPERSET_GUEST_TOKEN_JWT_SECRET=koridortj_guest_token_jwt_secret_abcdef123456

# ------------------------------------------------------------------------------
# 5. DEPLOYMENT & HOSTING (Coolify / VPS / Domains)
# ------------------------------------------------------------------------------
# Coolify API Token for CI/CD automated deployment trigger
COOLIFY_API_TOKEN=your_coolify_api_token_here

# Public Subdomains (configured in Coolify with automatic Traefik SSL)
DOMAIN_EMBED=koridortj.yourdomain.com
DOMAIN_DASHBOARD=dashboard.yourdomain.com
DOMAIN_DBTDOCS=dbtdocs.yourdomain.com

