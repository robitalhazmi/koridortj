FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir kafka-python-ng pydantic python-dotenv

COPY ingestion /app/ingestion
COPY data /app/data

ENV PYTHONPATH=/app
ENV KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ENV REPLAY_SPEED_MULTIPLIER=60.0

CMD ["python", "ingestion/replay_producer.py", "--bootstrap-servers", "kafka:9092", "--loop", "--speed-multiplier", "60"]
